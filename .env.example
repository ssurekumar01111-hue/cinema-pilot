# CinemaPilot — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# ─── Gemini Developer API Key ─────────────────────────────────────────────────
# Required by agents/storyboard/agent.py for native Gemini image generation.
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-developer-api-key-here

# ─── Grafana Cloud ────────────────────────────────────────────────────────────
# Required by shared/grafana_client.py and agents/producer/agent.py
GRAFANA_HOST=https://your-stack.grafana.net
GRAFANA_TOKEN=your-grafana-service-account-token
GRAFANA_PROMETHEUS_UID=your-prometheus-datasource-uid
GRAFANA_OTLP_ENDPOINT=https://your-stack.grafana.net/otlp
GRAFANA_OTLP_INSTANCE_ID=your-instance-id

# ─── Google Cloud ─────────────────────────────────────────────────────────────
# Set GOOGLE_APPLICATION_CREDENTIALS to a service account key file,
# or rely on Application Default Credentials (ADC) via gcloud auth.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/cinemapilot-sa.json
GCP_PROJECT=cinemapilot-2026
GCS_BUCKET=cinemapilot-2026-assets
BIGQUERY_DATASET=production_graph
