# CinemaPilot — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# ─── Gemini Developer API Key ─────────────────────────────────────────────────
# Required by agents/storyboard/agent.py for native Gemini image generation.
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-developer-api-key-here

# ─── Grafana Cloud MCP & Stack ────────────────────────────────────────────────
# Required by shared/grafana_client.py and agents/producer/agent.py / agents/risk/agent.py
GRAFANA_STACK_URL=https://your-stack.grafana.net
GRAFANA_PROMETHEUS_UID=grafanacloud-prom

# ─── Grafana Cloud OTLP (OpenTelemetry Metrics) ───────────────────────────────
# Required by shared/telemetry.py to export agent performance & cascade metrics
GRAFANA_CLOUD_INSTANCE_ID=your-instance-id
GRAFANA_CLOUD_OTLP_ENDPOINT=https://prometheus-prod-43-prod-ap-south-1.grafana.net/otlp/v1/metrics
GRAFANA_CLOUD_OTLP_TOKEN=your-grafana-cloud-access-policy-token

# ─── Google Cloud ─────────────────────────────────────────────────────────────
# Authenticates via Application Default Credentials (ADC) via `gcloud auth application-default login`.
GCP_PROJECT=cinemapilot-2026
GCS_BUCKET=cinemapilot-2026-assets
BIGQUERY_DATASET=production_graph
